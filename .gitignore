# ==============================================================================
# VertexAI Full-Stack Application (.gitignore)
# Stack: Node.js / JavaScript (Root, Backend, Frontend)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DEPENDENCIES
# ------------------------------------------------------------------------------
# Ignore node_modules anywhere in the repository
node_modules/
**/node_modules/
.pnp
.pnp.js

# Explicit subfolder dependency targets
/backend/node_modules/
/backend/**/node_modules/
/frontend/node_modules/

# ------------------------------------------------------------------------------
# 2. ENVIRONMENT VARIABLES & SECRETS
# ------------------------------------------------------------------------------
# Ignore all environment files and secret keys
.env
.env.*
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# API keys, certificates & service credentials
serviceAccountKey.json
*serviceAccount*.json
*.pem
*.key
*.cert
*.pfx
*.p12

# Explicit subfolder environment targets
/backend/.env
/backend/.env.*
/backend/**/.env
/backend/**/.env.*
/backend/**/serviceAccountKey.json
/frontend/.env
/frontend/.env.*
/frontend/.env.local
/frontend/.env.development.local
/frontend/.env.test.local
/frontend/.env.production.local

# Explicitly allow template / example environment and key files to be committed
!.env.example
!*.env.example
!**/.env.example
!.env.template
!*.env.template
!**/.env.template
!*.example.json
!**/*.example.json

# ------------------------------------------------------------------------------
# 3. BUILD, DIST & COMPILED OUTPUTS
# ------------------------------------------------------------------------------
dist/
dist-ssr/
build/
out/
.next/
*.tsbuildinfo

# Explicit subfolder build targets (Vite / Node bundlers)
/frontend/dist/
/frontend/dist-ssr/
/frontend/build/
/backend/dist/
/backend/build/
/backend/**/dist/
/backend/**/build/

# ------------------------------------------------------------------------------
# 4. SYSTEM LOGS & DEBUGGING
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Explicit subfolder log targets
/backend/logs/
/backend/**/*.log
/backend/npm-debug.log*
/backend/yarn-debug.log*
/backend/yarn-error.log*
/frontend/logs/
/frontend/**/*.log
/frontend/npm-debug.log*
/frontend/yarn-debug.log*
/frontend/yarn-error.log*

# ------------------------------------------------------------------------------
# 5. TESTING & CODE COVERAGE
# ------------------------------------------------------------------------------
coverage/
*.lcov
.nyc_output/
cypress/videos/
cypress/screenshots/
/backend/coverage/
/frontend/coverage/

# ------------------------------------------------------------------------------
# 6. CACHES & TEMPORARY RUNTIME FILES
# ------------------------------------------------------------------------------
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.turbo/
tmp/
temp/
/frontend/.vite/
/frontend/**/.vite/
/backend/tmp/
/backend/temp/

# ------------------------------------------------------------------------------
# 7. IDE & EDITOR SETTINGS
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
*.code-workspace

# JetBrains (IntelliJ, WebStorm, etc.)
.idea/
*.iws
*.iml
*.ipr

# Visual Studio / Windows IDE files
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
*.bak

# Sublime Text
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# 8. ANTIGRAVITY & AI ASSISTANT SETTINGS / WORKSPACE ARTIFACTS
# ------------------------------------------------------------------------------
.gemini/
.agents/
.sf/
.brain/
.system_generated/
*.system_generated/
antigravity.local.*

# ------------------------------------------------------------------------------
# 9. OPERATING SYSTEM ARTIFACTS
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# 10. DOCKER & LOCAL CONFIG OVERRIDES
# ------------------------------------------------------------------------------
docker-compose.override.yml
*.local
